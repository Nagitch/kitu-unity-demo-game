    {
      "address": "/input/arena/start",
      "category": "Input commands",
      "summary": "Start or retry a run",
      "source": "app/src/arena.rs",
      "arguments": []
    },
    {
      "address": "/input/arena/menu",
      "category": "Input commands",
      "summary": "Return to opening",
      "source": "app/src/arena.rs",
      "arguments": []
    },
    {
      "address": "/input/arena/pause",
      "category": "Input commands",
      "summary": "Pause an active run",
      "source": "app/src/arena.rs",
      "arguments": []
