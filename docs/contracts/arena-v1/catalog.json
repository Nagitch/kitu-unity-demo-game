    {
      "address": "/input/arena/close",
      "category": "Input commands",
      "summary": "Close inventory or chest",
      "source": "app/src/arena.rs",
      "arguments": []
    },
    {
      "address": "/input/arena/frame",
      "category": "Input commands",
      "summary": "Latest movement, aim and held-fire state",
      "source": "app/src/arena.rs",
      "arguments": [
        {
          "name": "move_x",
          "type": "float",
          "description": "World X movement axis."
        },
        {
          "name": "move_z",
          "type": "float",
          "description": "World Z movement axis."
        },
        {
          "name": "has_aim",
          "type": "bool",
          "description": "Whether aim coordinates are valid."
        },
        {
          "name": "aim_x",
          "type": "float",
          "description": "World X target position."
        },
        {
          "name": "aim_z",
          "type": "float",
          "description": "World Z target position."
        },
        {
          "name": "fire_a",
          "type": "bool",
          "description": "Weapon A held."
        },
        {
          "name": "fire_b",
          "type": "bool",
          "description": "Weapon B held."
        }
      ]
    },
    {
      "address": "/input/arena/use",
      "category": "Input commands",
      "summary": "Queue one consumable press",
      "source": "app/src/arena.rs",
      "arguments": [
        {
          "name": "slot",
          "type": "int",
          "description": "ItemA=2 or ItemB=3; other i32 values are structurally valid but rejected by game rules."
        }
      ]
    },
    {
      "address": "/input/arena/take",
      "category": "Input commands",
      "summary": "Take or swap a chest item",
      "source": "app/src/arena.rs",
      "arguments": [
        {
          "name": "item_id",
          "type": "int",
          "description": "Expected current item ID; stale IDs are rejected."
        },
        {
          "name": "backpack_index",
          "type": "int",
          "description": "Backpack position 0..2."
        }
      ]
    },
    {
      "address": "/input/arena/equip",
      "category": "Input commands",
      "summary": "Equip a backpack item",
      "source": "app/src/arena.rs",
      "arguments": [
        {
          "name": "item_id",
          "type": "int",
          "description": "Expected current item ID; stale IDs are rejected."
        },
        {
          "name": "backpack_index",
          "type": "int",
          "description": "Backpack position 0..2."
        },
        {
          "name": "equipment_slot",
          "type": "int",
          "description": "WeaponA=0, WeaponB=1, ItemA=2, ItemB=3."
        }
      ]
    },
    {
      "address": "/input/arena/unequip",
      "category": "Input commands",
