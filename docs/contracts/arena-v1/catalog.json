        {
          "name": "item_id",
          "type": "int",
          "description": "Expected current item ID; stale IDs are rejected."
        },
        {
          "name": "equipment_slot",
          "type": "int",
          "description": "WeaponA=0, WeaponB=1, ItemA=2, ItemB=3."
